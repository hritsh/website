---
import { profileData } from "../data/profile";
import { siteData } from "../data/site";

const { aboutModal } = siteData;
---

<div id="about-modal" class="modal">
	<div class="modal-backdrop"></div>
	<div class="modal-dialog outer-border">
		<div class="inner-border center">
			<div class="modal-contents">
				<h1 class="title">About This Website</h1>
				<div class="separator"></div>
				<div class="window-pane">
					<img src="/svg/myspace.svg" alt="Logo" class="modal-logo" />
					<div class="about">
						<strong>{aboutModal.product}</strong><br />
						Version <span data-version>Loading…</span><br />
						<strong>Last Update: </strong><span data-last-update data-repo={profileData.githubRepo}>Loading…</span><br />
						Built with <a href={aboutModal.builtWithUrl} target="_blank">{aboutModal.builtWithLabel}</a>
					</div>
					<div class="technologies">
						<strong>Technologies:</strong><br />
						{aboutModal.technologies}
					</div>
					<div>
						<strong>Contact:</strong><br />
						<a href={`mailto:${profileData.email}`}>{profileData.email}</a>
					</div>
				</div>
				<section class="field-row">
					<button class="btn" id="close-about-modal">Close</button>
				</section>
			</div>
		</div>
	</div>
</div>

<style>
	#about-modal {
		display: none;
	}

	.modal-dialog {
		width: 30rem;
		z-index: 1002;
	}

	.window-pane {
		text-align: center;
	}

	.modal-logo {
		width: 48px;
		height: 48px;
		margin-bottom: 10px;
	}

	.about {
		margin-bottom: 10px;
	}

	.technologies {
		margin-bottom: 10px;
	}

	.field-row {
		justify-content: flex-end;
	}
</style>
