---
import { siteData } from "../data/site";

export interface Props {
	title: string;
	description?: string;
}

const { title, description = siteData.meta.description } = Astro.props;
const { meta } = siteData;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta http-equiv="X-UA-Compatible" content="ie=edge" />

		<title>{title.toLowerCase()}</title>
		<meta name="description" content={description} />
		<meta name="author" content={meta.author} />
		<meta name="keywords" content={meta.keywords} />

		<!-- open graph (for link previews) -->
		<meta property="og:title" content={`${title} | ${meta.author}`} />
		<meta property="og:description" content={meta.ogDescription} />
		<meta property="og:image" content={meta.image} />
		<meta property="og:url" content={meta.url} />
		<meta property="og:type" content="website" />

		<!-- twitter card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={`${title} | ${meta.author}`} />
		<meta name="twitter:description" content={meta.twitterDescription} />
		<meta name="twitter:image" content={meta.image} />

		<!-- favicon & styles -->
		<link rel="icon" type="image/x-icon" href="/favicon2.ico" />
		<link rel="stylesheet" href="https://unpkg.com/@sakun/system.css" />
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.16.0/devicon.min.css" />
	</head>

	<body>
		<slot />

		<script>
			import "/src/scripts/modal.js";
			import "/src/scripts/clock.js";
			import "/src/scripts/apple-hover.js";
			import "/src/scripts/github-update.js";
		</script>
		<script
			data-goatcounter="https://hritish.goatcounter.com/count"
			data-goatcounter-settings='{"allow_local": true}'
			async
			src="//gc.zgo.at/count.js"></script>
		<script defer src="https://cloud.umami.is/script.js" data-website-id="1ba3cd54-08e1-48b8-b389-bdc7d7e82027"></script>
	</body>
</html>

<style is:global>
	@import "/src/styles/global.css";
	@import "/src/styles/components.css";
	@import "/src/styles/header.css";
</style>
